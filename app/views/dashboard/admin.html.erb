<div class="card shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="fw-semibold">Manage Users</h3>
      <button id="reloadBtn" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-arrow-clockwise"></i> Reload
      </button>
    </div>

    <%= render 'dashboard/partials/users_table' %>

    <hr class="my-4">

    <h5 class="fw-semibold mb-3">Create New User</h5>
    <%= render 'dashboard/partials/new_user_form' %>

    <div id="alertBox" class="mt-3"></div>
  </div>
</div>

<%= render 'dashboard/partials/admin_scripts' %>
