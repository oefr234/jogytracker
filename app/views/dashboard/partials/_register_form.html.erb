<div id="registerForm" style="display:none;">
  <div class="mb-3">
    <label class="form-label">Name</label>
    <input id="regName" type="text" class="form-control" placeholder="Your name">
  </div>

  <div class="mb-3">
    <label class="form-label">Email</label>
    <input id="regEmail" type="email" class="form-control" placeholder="you@example.com">
  </div>

  <div class="mb-3">
    <label class="form-label">Password</label>
    <input id="regPass" type="password" class="form-control" placeholder="••••••••">
  </div>

  <div class="mb-3">
    <label class="form-label">Confirm Password</label>
    <input id="regPassConf" type="password" class="form-control" placeholder="••••••••">
  </div>

  <button id="registerBtn" class="btn btn-success w-100">Register</button>

  <div class="text-center mt-3">
    <span class="text-muted">Already have an account?</span>
    <a href="#" id="showLogin">Back to Login</a>
  </div>
</div>
