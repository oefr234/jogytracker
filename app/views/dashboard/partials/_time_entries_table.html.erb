<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-semibold">My Time Entries</h4>
  <div>
    <button id="manageUsersBtn" class="btn btn-outline-secondary btn-sm me-2" style="display:none;">Manage Users</button>
    <button id="logoutBtn" class="btn btn-outline-danger btn-sm">Logout</button>
  </div>
</div>

<form class="row g-2 mb-3">
  <div class="col-auto">
    <input id="filterFrom" type="date" class="form-control form-control-sm" placeholder="From">
  </div>
  <div class="col-auto">
    <input id="filterTo" type="date" class="form-control form-control-sm" placeholder="To">
  </div>
  <div class="col-auto">
    <input id="filterLocation" type="text" class="form-control form-control-sm" placeholder="Location">
  </div>
  <div class="col-auto">
    <button id="applyFilter" type="button" class="btn btn-sm btn-primary">Filter</button>
  </div>
</form>

<table id="entriesTbl" class="table table-sm table-hover align-middle">
  <thead class="table-light">
  <tr>
    <th>Date</th>
    <th>Distance (km)</th>
    <th>Duration (sec)</th>
    <th>Location</th>
    <th>Avg speed (km/h)</th>
    <th>Actions</th>
  </tr>
  </thead>
  <tbody></tbody>
</table>

<hr>

<h5 class="fw-semibold">Add / Edit Entry</h5>
<div class="row g-2 mb-2">
  <div class="col-md-3">
    <input id="date" type="date" class="form-control form-control-sm">
  </div>
  <div class="col-md-3">
    <input id="distance" type="number" step="0.01" class="form-control form-control-sm" placeholder="km">
  </div>
  <div class="col-md-3">
    <input id="duration" type="number" class="form-control form-control-sm" placeholder="seconds">
  </div>
  <div class="col-md-3">
    <input id="location" type="text" class="form-control form-control-sm" placeholder="Location">
  </div>
</div>

<div class="d-flex gap-2 mb-3">
  <button id="saveBtn" type="button" class="btn btn-sm btn-success flex-fill">Save</button>
  <button id="cancelEdit" type="button" class="btn btn-sm btn-outline-secondary flex-fill">Cancel</button>
</div>

<input type="hidden" id="entryId">
<p id="msg" class="text-muted small"></p>
